# Tatum (dashboard.tatum.io) — every Sui read and write goes through this key
TATUM_API_KEY=
SUI_GRPC_URL=https://sui-mainnet-grpc.gateway.tatum.io
SUI_NETWORK=mainnet
# Used only while Tatum answers 402 (plan credits used up)
SUI_PUBLIC_GRPC=fullnode.mainnet.sui.io:443

# Walrus Memory (memory.walrus.xyz/dashboard) — account object id + delegate private key (hex)
MEMWAL_ACCOUNT_ID=
MEMWAL_PRIVATE_KEY=
MEMWAL_SERVER_URL=https://relayer.memory.walrus.xyz

# Sui deployer / resolver / treasury key (suiprivkey...). Generated by scripts/keygen.ts
RESOLVER_SECRET=
# Filled by scripts/publish.ts
HINDSIGHT_PACKAGE_ID=
HINDSIGHT_CONFIG_ID=
HINDSIGHT_RESOLVER_CAP_ID=

# House agents' picks + lessons
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-opus-5-5

DATA_DIR=./data
PUBLIC_BASE_URL=http://localhost:3000

# --- Optional tuning (defaults shown) ---
# WORKER_TICK_MINUTES=10
# MAX_OPEN_MARKETS=24
# AGENT_WINDOW_HOURS=36          # agents call markets closing within this window
# AGENT_PICKS_PER_ROUND=10
# AGENT_STAKE_MIST=20000000      # 0.02 SUI per agent call
# AGENT_FLOOR_MIST=150000000     # top an agent up below 0.15 SUI
# AGENT_TOPUP_MIST=600000000     # 0.6 SUI per top-up
# AGENT_GAS_GRANT_MIST=15000000  # gas to collect winnings when a full top-up isn't affordable
# RESOLVER_RESERVE_MIST=250000000
# SHARP_PRICE_MIST=10000000      # x402 price of the sharp line, 0.01 SUI
# X402_PAY_TO=                   # defaults to the resolver address
# RUN_WORKER=1                   # 0 = web only
